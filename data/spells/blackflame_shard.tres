[resource]
script = ExtResource("5_gnu3k")
id = &"blackflame_shard"
display_name = "Blackflame Shard"
description = "Launch a pale-edged blackflame shard toward your aim or locked enemy. Deals 120 fire damage on impact, then burns 2% of the target's maximum health over 0.75 seconds at 10 Arcane. Diminishing returns raise the burn to 5% over 1.25 seconds at 60 Arcane, with no benefit above 60. Fire damage respects fire defence; the percentage burn bypasses defence but respects invulnerability. The burn persists after impact. Repeated hits refresh the burn instead of stacking it. Uses replenish at shrines."
school = "Arcane"
icon = ExtResource("spell_icon")
cast = ExtResource("1_1fp3g")
delivery_definition = SubResource("Resource_1fp3g")
charges = 10
maximum_charges = 10
