[resource]
script = ExtResource("spell")
id = &"blackflame_bond"
display_name = "Blackflame Bond"
description = "Hold a blackflame tether for up to 2 seconds. First contact deals 120 fire damage and applies one lingering burn: 2% of maximum health over 0.75 seconds at 10 Arcane, rising with diminishing returns to 5% over 1.25 seconds at 60 Arcane. Higher Arcane grants no further benefit. Fire damage respects fire defence; the percentage burn bypasses defence but respects invulnerability. The burn finishes after release. Holding the link does not repeat the impact or burn. Uses replenish at shrines."
school = "Arcane"
icon = ExtResource("spell_icon")
cast = ExtResource("blackflame")
delivery_definition = SubResource("Delivery")
charges = 10
maximum_charges = 10
delivery = "Tether"
