[sub_resource type="Resource" id="Damage"]
script = ExtResource("damage")
physical = 0.0

[sub_resource type="Resource" id="Attack"]
script = ExtResource("attack")
damage = SubResource("Damage")
poise_damage = 0.0
knockback = 0.0
windup = 0.22
recovery = 0.25

[sub_resource type="Resource" id="Heal"]
script = ExtResource("effect")
id = &"halo_heal"
health_restore = 15

[sub_resource type="Resource" id="Delivery"]
script = ExtResource("delivery")
radius = 360.0
attack = SubResource("Attack")
effects = Array[ExtResource("effect")]([SubResource("Heal")])
vfx = ExtResource("vfx")
tick_interval = 0.5
target_filter = "Friendly"

[resource]
script = ExtResource("spell")
id = &"delivery_aura"
display_name = "Mending Halo"
description = "Carry a healing sanctuary for 6 seconds, restoring 15 health every half-second to you and nearby allies. Uses replenish at shrines."
school = "Arcane"
icon = ExtResource("spell_icon")
cast = SubResource("Attack")
delivery_definition = SubResource("Delivery")
charges = 8
maximum_charges = 8
delivery = "Aura"
