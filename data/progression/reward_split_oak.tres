[gd_resource type="Resource" script_class="RewardDefinition" format=3]
[ext_resource type="Script" path="res://scripts/resources/reward_definition.gd" id="script"]
[ext_resource type="Script" path="res://scripts/resources/spell_definition.gd" id="spell_type"]
[ext_resource type="Script" path="res://scripts/resources/weapon_definition.gd" id="weapon_type"]
[ext_resource type="Resource" path="res://data/spells/moon_arc.tres" id="moon_arc"]
[ext_resource type="Resource" path="res://data/spells/astral_edge.tres" id="astral_edge"]
[ext_resource type="Resource" path="res://data/weapons/pilgrim_spear.tres" id="pilgrim_spear"]
[resource]
script = ExtResource("script")
display_name = "Split Oak Remains"
spells = Array[ExtResource("spell_type")]([ExtResource("moon_arc"), ExtResource("astral_edge")])
weapons = Array[ExtResource("weapon_type")]([ExtResource("pilgrim_spear")])
materials = Dictionary[String, int]({"ember_shard": 3})
embers = 120
memory_bonus = 0

