[gd_resource type="Resource" script_class="RewardDefinition" format=3]
[ext_resource type="Script" path="res://scripts/resources/reward_definition.gd" id="script"]
[ext_resource type="Script" path="res://scripts/resources/spell_definition.gd" id="spell_type"]
[ext_resource type="Script" path="res://scripts/resources/weapon_definition.gd" id="weapon_type"]
[ext_resource type="Resource" path="res://data/spells/cinder_field.tres" id="cinder_field"]
[ext_resource type="Resource" path="res://data/spells/furnace_breath.tres" id="furnace_breath"]
[resource]
script = ExtResource("script")
display_name = "Furnace Ledger"
spells = Array[ExtResource("spell_type")]([ExtResource("cinder_field"), ExtResource("furnace_breath")])
weapons = Array[ExtResource("weapon_type")]([])
materials = Dictionary[String, int]({"ember_shard": 3})
embers = 120
memory_bonus = 0

