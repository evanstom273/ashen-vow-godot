[ext_resource type="Resource" path="res://data/spells/blackflame_shard.tres" id="blackflame_shard"]
[resource]
script = ExtResource("script")
display_name = "The Widow's Offering"
spells = Array[ExtResource("spell_type")]([ExtResource("mending_halo"), ExtResource("blackflame_shard")])
weapons = Array[ExtResource("weapon_type")]([])
materials = Dictionary[String, int]({"ember_shard": 3})
embers = 120
memory_bonus = 0

