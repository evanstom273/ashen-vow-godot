[gd_resource type="Resource" script_class="RewardDefinition" format=3]
[ext_resource type="Script" path="res://scripts/resources/reward_definition.gd" id="script"]
[ext_resource type="Script" path="res://scripts/resources/spell_definition.gd" id="spell_type"]
[ext_resource type="Script" path="res://scripts/resources/weapon_definition.gd" id="weapon_type"]
[ext_resource type="Resource" path="res://data/spells/star_shard.tres" id="star_shard"]
[ext_resource type="Resource" path="res://data/spells/watchful_shards.tres" id="watchful_shards"]
[ext_resource type="Resource" path="res://data/weapons/court_staff.tres" id="court_staff"]
[resource]
script = ExtResource("script")
display_name = "Wayfarer's Testament"
spells = Array[ExtResource("spell_type")]([ExtResource("star_shard"), ExtResource("watchful_shards")])
weapons = Array[ExtResource("weapon_type")]([ExtResource("court_staff")])
materials = Dictionary[String, int]({"ember_shard": 3})
embers = 120
memory_bonus = 1

