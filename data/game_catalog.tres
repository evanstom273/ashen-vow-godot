[resource]
resource_name = "Ashen Vow - Game Data"
script = ExtResource("script")
classes = Array[ExtResource("class_type")]([ExtResource("class")])
weapons = Array[ExtResource("weapon_type")]([ExtResource("sword"), ExtResource("blade"), ExtResource("dagger"), ExtResource("shield"), ExtResource("mace"), ExtResource("spear"), ExtResource("greatblade"), ExtResource("staff"), ExtResource("seal"), ExtResource("wand")])
enemies = Array[ExtResource("enemy_type")]([ExtResource("sentinel"), ExtResource("dummy")])
utilities = Array[ExtResource("utility_type")]([ExtResource("flask"), ExtResource("tonic")])
weapon_loadouts = Array[ExtResource("weapon_loadout_type")]([ExtResource("left_loadout"), ExtResource("right_loadout")])
spell_loadouts = Array[ExtResource("spell_loadout_type")]([ExtResource("spell_loadout")])
utility_loadouts = Array[ExtResource("utility_loadout_type")]([ExtResource("utility_loadout")])
currencies = Array[ExtResource("currency_type")]([ExtResource("currency")])
shrines = Array[ExtResource("shrine_type")]([ExtResource("shrine")])
