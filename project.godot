[layer_names]

2d_physics/layer_1="Ground obstacles / humanoid"
2d_physics/layer_2="Enemies / targets"
2d_physics/layer_3="Summons"
2d_physics/layer_4="Transformed player"
2d_physics/layer_5="Flight blocker"
2d_physics/layer_6="No landing / water / gaps"
2d_physics/layer_9="Elevated ground obstacles / humanoid (managed)"
2d_physics/layer_10="Elevated enemies / targets (managed)"
2d_physics/layer_11="Elevated summons (managed)"
2d_physics/layer_12="Elevated transformed player (managed)"
2d_physics/layer_13="Elevated flight blocker (managed)"
2d_physics/layer_14="Elevated no landing (managed)"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
